// ==========================================
// 1. CONFIGURATION & DATASOURCE
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 2. ENUMS (กำหนดค่าสถานะและสิทธิ์การใช้งานตายตัว)
// ==========================================
enum Role {
  ADMIN    // ผู้ดูแลระบบสูงสุด
  TEACHER  // คุณครูผู้สอน / ครูประจำชั้น
}

enum AttendanceStatus {
  PRESENT  // มาเรียน
  ABSENT   // ขาดเรียน
  LATE     // มาสาย
  LEAVE    // ลา (ป่วย/กิจ)
}

enum SchoolLevel {
  KINDERGARTEN
  PRIMARY
}

// ==========================================
// 3. USER MODEL (ข้อมูลผู้ใช้งานระบบ: ครู และ แอดมิน)
// ==========================================
model User {
  id           String   @id @default(cuid())
  username     String   @unique // ชื่อผู้ใช้งานสำหรับ Login
  passwordHash String   // รหัสผ่านที่เข้ารหัสแล้ว
  fullName     String   // ชื่อ-นามสกุลจริง
  role         Role     @default(TEACHER) // สิทธิ์การใช้งาน
  isActive     Boolean  @default(true)    // สถานะบัญชี (เปิด/ปิดใช้งาน)
  createdAt    DateTime @default(now())   // วันเวลาที่สร้างบัญชี

  // ความสัมพันธ์: ครู 1 คน สามารถดูแลได้หลายห้องเรียน
  classrooms TeacherClassroom[]
  // ความสัมพันธ์: ครู 1 คน เป็นผู้กดบันทึกการเช็คชื่อได้หลายรอบ
  sessions   AttendanceSession[]
}

// ==========================================
// 4. CLASSROOM MODEL (ข้อมูลห้องเรียน ป.1 - ป.6)
// ==========================================
model Classroom {
  id           String      @id @default(cuid())
  level        SchoolLevel @default(PRIMARY)
  grade        Int
  room         Int         @default(1)
  academicYear Int

  teachers    TeacherClassroom[]
  enrollments Enrollment[]
  sessions    AttendanceSession[]

  @@unique([level, grade, room, academicYear])
}

// ==========================================
// 5. TEACHER CLASSROOM (ตารางเชื่อม: ครู ⟷ ห้องเรียน)
// ==========================================
model TeacherClassroom {
  userId      String // รหัสคุณครู
  classroomId String // รหัสห้องเรียน
  
  user        User      @relation(fields: [userId], references: [id])
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  @@id([userId, classroomId])
}

// ==========================================
// 6. STUDENT MODEL (ข้อมูลนักเรียน)
// ==========================================
model Student {
  id           String    @id @default(cuid())
  studentCode  String    @unique
  prefix       String?
  firstName    String
  lastName     String
  birthDate    DateTime? @db.Date
  fatherName   String?
  motherName   String?
  guardianName String?
  phone        String?
  isActive     Boolean   @default(true)

  enrollments Enrollment[]
  records     AttendanceRecord[]
}

// ==========================================
// 7. ENROLLMENT MODEL (การสังกัดห้องเรียนของนักเรียน)
// ==========================================
model Enrollment {
  studentId   String
  classroomId String
  number      Int?    // เลขที่ของนักเรียนประจำห้องนั้นๆ
  
  student     Student   @relation(fields: [studentId], references: [id])
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  @@id([studentId, classroomId])
}

// ==========================================
// 8. ATTENDANCE SESSION (รอบการเช็คชื่อประจำวันของห้องเรียน)
// ==========================================
model AttendanceSession {
  id          String   @id @default(cuid())
  classroomId String   // เช็คชื่อของห้องไหน
  date        DateTime @db.Date // วันที่ทำการเช็คชื่อ (ไม่เอาเวลา)
  takenById   String   // ครูคนไหนเป็นคนบันทึก
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id])
  takenBy   User      @relation(fields: [takenById], references: [id])
  
  // รายละเอียดผลเช็คชื่อของเด็กทุกคนในเซสชันนี้
  records   AttendanceRecord[]

  // 1 ห้องเรียน จะบันทึกเช็คชื่อได้แค่ 1 ครั้งต่อวันเท่านั้น
  @@unique([classroomId, date])
}

// ==========================================
// 9. ATTENDANCE RECORD (รายละเอียดผลการเช็คชื่อรายบุคคล)
// ==========================================
model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String           // อ้างอิงรอบการเช็คชื่อ (Session)
  studentId String           // รหัสนักเรียน
  status    AttendanceStatus // สถานะการมาเรียน (มา, ขาด, สาย, ลา)
  note      String?          // หมายเหตุเพิ่มเติม (เช่น ป่วยนอนโรงพยาบาล, ลากิจ)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id])

  // ป้องกันการบันทึกสถานะซ้ำซ้อนของนักเรียนคนเดิมในเซสชันเดียวกัน
  @@unique([sessionId, studentId])
}